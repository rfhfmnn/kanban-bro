# ==========================================
# Kanban Bro Backend - Database Configuration
# ==========================================

# Option 1: SQLite (Default fallback if nothing is set)
# DATABASE_URL=sqlite:///./kanban.db

# Option 2: PostgreSQL via full connection URL (matches interview-canvas-db container)
DATABASE_URL=postgresql://sdip:sdip@localhost:5432/sdip

# Option 3: PostgreSQL via individual environment variables
# POSTGRES_USER=sdip
# POSTGRES_PASSWORD=sdip
# POSTGRES_DB=sdip
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Automatic Seeding on startup (true or false)
AUTO_SEED=true
